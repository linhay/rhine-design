{
  "name": "@tod-ai/design-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable ToD-AI React components, design specifications and motion previews",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "exports": {
    ".": "./components/index.ts",
    "./tokens.css": "./components/tokens.css",
    "./styles.css": "./components/styles.css",
    "./logo.svg": "./components/assets/logo.svg"
  },
  "sideEffects": [
    "./components/index.ts",
    "**/*.css"
  ],
  "files": [
    "components",
    "preview",
    "design",
    "docs",
    "tests",
    "index.html",
    "README.md",
    "tsconfig.json",
    "vite.config.ts",
    "vitest.config.ts",
    "package-lock.json",
    "scripts"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18309 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "check": "npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
